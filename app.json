{
  "expo": {
    "name": "KTIDEBT",
    "slug": "ktidebt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/image_29e2d51-removebg-preview.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1A365D"
    },
    "scheme": "ktidebt",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ktidebt.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#a2d2ff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.ktidebt.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-contacts",
        {
          "contactsPermission": "KTIDEBT needs access to your contacts to select debtors."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#1A365D"
        }
      ],
      "expo-local-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef3922ad-6501-4b8c-ba57-c8d63c4b0808"
      }
    },
    "owner": "ntlalat26"
  }
}
